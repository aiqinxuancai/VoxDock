# ============================== VoxDock ==============================
# 复制为 .env 后按需填写。平台密钥也可以在 Web「平台配置」页面填写（数据库中的配置优先）。

# 管理员密码：设置后 Web 需登录、API 需携带 API Key；留空则不鉴权（仅建议本地使用）
VOXDOCK_ADMIN_PASSWORD=

# 会话签名密钥，留空自动生成并保存在数据目录
VOXDOCK_SECRET_KEY=

# 额外的静态 API Key（逗号分隔），也可在 Web「API 接入」页面创建
VOXDOCK_API_KEYS=

# 数据目录（SQLite 数据库与音频文件），Docker 中默认为 /data
# VOXDOCK_DATA_DIR=data
# VOXDOCK_PORT=8000
# Windows 免安装版 / python -m app 专用：监听地址（默认仅本机 127.0.0.1，0.0.0.0 允许局域网访问）与是否自动打开浏览器
# VOXDOCK_HOST=127.0.0.1
# VOXDOCK_NO_BROWSER=1
# VOXDOCK_REQUEST_TIMEOUT=120
# VOXDOCK_MAX_UPLOAD_MB=20

# ------------------------------ 火山引擎 ------------------------------
# 新版控制台 API Key，或旧版 AppID + Access Token（二选一）
VOLC_API_KEY=
VOLC_APP_ID=
VOLC_ACCESS_TOKEN=
# 已购买的音色 ID，用于同步（逗号分隔）
VOLC_SPEAKER_IDS=

# ------------------------- 阿里云百炼（CosyVoice / 千问）-------------------------
DASHSCOPE_API_KEY=
# 新加坡地域：https://dashscope-intl.aliyuncs.com
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com

# ------------------------------ MiniMax ------------------------------
MINIMAX_API_KEY=
# 国际站：https://api.minimax.io
# MINIMAX_BASE_URL=https://api.minimax.cn

# ------------------------------ 智谱 AI ------------------------------
ZHIPU_API_KEY=
